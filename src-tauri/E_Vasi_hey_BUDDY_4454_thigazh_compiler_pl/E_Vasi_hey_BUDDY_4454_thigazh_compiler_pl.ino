// செயல் அமைப்பு → Arduino setup()
void setup() {
    Serial.begin(9600);
    Serial.println("திகழ் for loop தொடங்கியது!");
}

// செயல் சுழல் → Arduino loop()
void loop() {
    for (int i = 0; i < 5; i++) {
        Serial.println(i);
    }
    delay(2000);
}

